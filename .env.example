# ---------------------------------------------------------------------------
# pharos-docs configuration — PLACEHOLDERS ONLY.
#
# Copy to `.env` (git-ignored) or export these in your shell.
# Never commit a real token. The CLI redacts secrets from all output.
# ---------------------------------------------------------------------------

# Optional: a pre-existing Pharos Agent Center bearer token (AUTHENTICATED scope).
# Only needed if you do not want to run `pharos-docs --login`, e.g. in CI.
# The Pharos Docs MCP rejects anonymous guest sessions.
PHAROS_ACCESS_TOKEN=

# Optional: override where the cached login session is stored.
# Default: .local/session.json (git-ignored)
PHAROS_STATE_FILE=.local/session.json

# Optional: stream deadline in milliseconds for one Docs MCP answer.
# The hosted agent routinely takes 30-150s. Default: 300000
PHAROS_STREAM_TIMEOUT_MS=300000
